# Open V Business Solutions — cPanel deployment hardening
# These headers take effect only when this file is deployed on Apache with mod_headers.

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Enable only after HTTPS is confirmed on every production hostname/subdomain.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
